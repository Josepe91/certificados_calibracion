rules_version = '2';

// Reglas mínimas para el inventario compartido entre técnicos:
// - Solo dispositivos autenticados (auth anónima, ver TecnicoProfile /
//   InventarioSync en la app) pueden leer o escribir.
// - No se exige más granularidad (por ejemplo, por empresa) porque hoy
//   todos los técnicos de BTMC trabajan los mismos clientes.
service cloud.firestore {
  match /databases/{database}/documents {
    // Versión mínima de la app (ver lib/data/version_app.dart). Cualquier
    // técnico la lee; solo se puede SUBIR el número, nunca bajarlo — así un
    // celular con un build viejo no puede "desbloquearse" a sí mismo.
    match /config/app {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.version_minima is int
        && (resource == null
            || request.resource.data.version_minima > resource.data.version_minima);
    }

    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;

      match /equipos/{equipoId} {
        allow read, write: if request.auth != null;
      }

      // Solicitudes (certificado + mediciones + fotos) — mismo criterio
      // de acceso que equipos: cualquier técnico autenticado, sin
      // restricción por técnico individual.
      match /solicitudes/{equipoId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
