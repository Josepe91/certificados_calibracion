rules_version = '2';

// Acceso por cuenta de Google (ver lib/data/auth_tecnico.dart).
//
// TRANSICIÓN: mientras los técnicos sigan con builds viejos (auth anónima),
// transicion() devuelve true y cualquier sesión entra como antes. El día que
// todos actualicen e inicien sesión con Google: cambiar a `false` y
// desplegar (`firebase deploy --only firestore:rules,storage`). Desde ahí solo
// entran los correos de esTecnico(). Si se agrega un técnico, agregarlo aquí,
// en storage.rules y en AuthTecnico.tecnicos.
service cloud.firestore {
  match /databases/{database}/documents {
    function transicion() {
      return true;
    }

    function correoVerificado() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function esAdmin() {
      return correoVerificado()
        && request.auth.token.email == 'sebasperez1691@gmail.com';
    }

    function esTecnico() {
      return (transicion() && request.auth != null)
        || (correoVerificado() && request.auth.token.email in [
          'sebasperez1691@gmail.com',
          'direcciontecnica.btm@gmail.com',
          'biomedico.btm@gmail.com',
          'forero2701@gmail.com'
        ]);
    }

    // Versión mínima de la app (ver lib/data/version_app.dart). La lectura
    // queda abierta a cualquier sesión (también anónima) A PROPÓSITO: así un
    // celular con un build viejo puede seguir leyendo que está bloqueado y
    // ver el aviso de actualizar. Solo se puede SUBIR el número, nunca
    // bajarlo.
    match /config/app {
      allow read: if request.auth != null;
      allow write: if esTecnico()
        && request.resource.data.version_minima is int
        && (resource == null
            || request.resource.data.version_minima > resource.data.version_minima);
    }

    match /clientes/{clienteId} {
      allow read, write: if esTecnico();

      match /equipos/{equipoId} {
        allow read, write: if esTecnico();
      }

      // Solicitudes (certificado + mediciones + fotos): cualquier técnico.
      match /solicitudes/{equipoId} {
        allow read, write: if esTecnico();
      }

      // "Certificado montado" (lib/data/montajes_sync.dart): lo ven todos,
      // pero SOLO Sebastián lo marca/desmarca — ni siquiera en transición.
      match /montajes/{equipoId} {
        allow read: if esTecnico();
        allow write: if esAdmin();
      }
    }

    // Aviso de número de certificado repetido: consultas collection group
    // sobre equipos/solicitudes de todos los clientes
    // (InventarioSync.buscarCertificadoEnNube).
    match /{ruta=**}/equipos/{equipoId} {
      allow read: if esTecnico();
    }
    match /{ruta=**}/solicitudes/{equipoId} {
      allow read: if esTecnico();
    }
  }
}
