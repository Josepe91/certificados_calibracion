rules_version = '2';

// Fotos de solicitudes, certificados e inventarios en Excel. Mismo criterio
// que firestore.rules (ver allí la nota de TRANSICIÓN): cambiar
// transicion() a false el mismo día que en firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    function transicion() {
      return true;
    }

    function esTecnico() {
      return (transicion() && request.auth != null)
        || (request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
            'sebasperez1691@gmail.com',
            'direcciontecnica.btm@gmail.com',
            'biomedico.btm@gmail.com',
            'forero2701@gmail.com'
          ]);
    }

    match /clientes/{clienteId}/solicitudes/{equipoId}/{archivo} {
      allow read, write: if esTecnico();
    }

    // Certificados e inventarios en Excel (ver lib/data/excel_nube.dart).
    match /certificados/{clienteId}/{equipoId}/{archivo} {
      allow read, write: if esTecnico();
    }
    match /inventarios/{clienteId}/{archivo} {
      allow read, write: if esTecnico();
    }
  }
}
