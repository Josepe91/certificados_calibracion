rules_version = '2';

// Fotos de solicitudes de calibración. Mismo criterio que firestore.rules:
// cualquier técnico autenticado (auth anónima) puede leer/escribir — no hay
// restricción por técnico individual porque todos trabajan los mismos
// clientes.
service firebase.storage {
  match /b/{bucket}/o {
    match /clientes/{clienteId}/solicitudes/{equipoId}/{archivo} {
      allow read, write: if request.auth != null;
    }

    // Certificados e inventarios en Excel (ver lib/data/excel_nube.dart),
    // mismo criterio de acceso.
    match /certificados/{clienteId}/{equipoId}/{archivo} {
      allow read, write: if request.auth != null;
    }
    match /inventarios/{clienteId}/{archivo} {
      allow read, write: if request.auth != null;
    }
  }
}
